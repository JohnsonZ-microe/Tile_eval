# Force LF for all text files: the VCS/DC server flow requires LF
# (bash wrappers, Tcl line continuations, $readmemh tolerance).
* text=auto eol=lf
*.sv text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.tcl text eol=lf
*.f text eol=lf
*.md text eol=lf
*.json text eol=lf
*.hex text eol=lf
*.svg binary
*.png binary
